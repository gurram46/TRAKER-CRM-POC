# ── Zoho Mail Integration ──
# Get these from https://api-console.zoho.in/

ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_REDIRECT_URI=http://localhost:3001/auth/zoho/callback
ZOHO_ACCOUNT_ID=        # Get from Zoho Mail → Settings → Account ID
ZOHO_MAIL_DOMAIN=https://mail.zoho.in
ZOHO_AUTH_DOMAIN=https://accounts.zoho.in

# ── Server ──
PORT=3001
